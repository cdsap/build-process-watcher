{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:base"],
  "enabledManagers": ["npm", "github-actions"],
  "packageRules": [
    {
      "description": "Automerge safe npm patch/minor updates only after required CI status checks pass",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["patch", "minor"],
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "merge-commit"
    },
    {
      "description": "Track GitHub Actions updates; automerge patch/minor after required CI status checks pass",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["patch", "minor"],
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "merge-commit"
    }
  ]
}
