{
  "compilerOptions": {
    "target": "es2019",
    "module": "commonjs",
    "outDir": "./dist",
    "rootDir": "./",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "declaration": true
  },
  "include": [
    "*.ts",
    "src/index.ts",
    "src/index_with_backend.ts",
    "src/cleanup.ts",
    "src/daemonitor.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
